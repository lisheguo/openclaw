{
  "id": "glpi-ticket-gate-gen12",
  "name": "GLPI Ticket Gate (gen12)",
  "description": "Shadow-mode GLPI ticket template gate: deterministic ticket-intent detection, glpi-ticket skill injection, 7-item preflight, entity-lookup/preview/confirmation evidence, WOULD_ALLOW/WOULD_BLOCK telemetry. Phase1: never blocks. gen12: run-scoped identity binding + owner bypass config.",
  "categories": [
    "other"
  ],
  "contracts": {
    "tools": [
      "glpi_ticket_preflight"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "shadow"
        ],
        "default": "shadow"
      },
      "ownerSenderIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "skillPath": {
        "type": "string"
      },
      "ttlMs": {
        "type": "number"
      },
      "entityListToolId": {
        "type": "string"
      },
      "entityGetToolId": {
        "type": "string"
      },
      "createTicketToolId": {
        "type": "string"
      },
      "identityFallback": {
        "type": "string",
        "enum": [
          "session",
          "off"
        ],
        "default": "session"
      },
      "identityTtlMs": {
        "type": "number"
      }
    }
  }
}